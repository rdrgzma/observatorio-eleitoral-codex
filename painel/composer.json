{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "observatorio/painel",
    "type": "project",
    "description": "Funda\u00e7\u00e3o local do Observat\u00f3rio Eleitoral; sem proje\u00e7\u00f5es p\u00fablicas",
    "keywords": [
        "laravel",
        "framework"
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@php vendor/bin/phpunit --fail-on-warning"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
